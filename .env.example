# DeviceKit Environment Configuration

# API
API_PORT=5050
API_HOST=0.0.0.0

# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# DynamoDB
DYNAMODB_TABLE_PREFIX=devicekit_
DYNAMODB_ENDPOINT=http://localhost:8000

# Persistence (SQLAlchemy)
# Default is an embedded SQLite file at backend/devicekit.db. Point this at a Postgres
# URL to scale out, e.g. postgresql+psycopg2://user:pass@host:5432/devicekit
# DEVICEKIT_DATABASE_URL=sqlite:///devicekit.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Devices (comma-separated serial numbers)
DEVICE_IDS=

# Logging
LOG_LEVEL=INFO

# AI Agent (Prompture)
PROMPTURE_DEFAULT_MODEL=claude/claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GOOGLE_API_KEY=AI...
# OLLAMA_HOST=http://localhost:11434

# Prompture Hub (optional AI backend — ai.backend=hub in Settings → AI).
# HUB_ADMIN_TOKEN lets DeviceKit mint per-extension scoped hub keys (model whitelist +
# daily spend cap). Must match the token the hub itself runs with. Env-only on purpose.
# HUB_ADMIN_TOKEN=change-me
