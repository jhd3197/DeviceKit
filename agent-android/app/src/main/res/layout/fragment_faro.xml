<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Storage permission prompt (agent is useless without all-files access) -->
        <LinearLayout
            android:id="@+id/faroStoragePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage access needed"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faro browses and transfers this device's files, which requires all-files access."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/faroGrantStorageButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Grant access"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/indigo"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Enable + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/faroStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp" />

                <TextView
                    android:id="@+id/faroStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Off"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/faroEnableToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lets your Faro desktop browse, transfer, and sync this device's files over an encrypted, paired connection."
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/faroAddressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Identity"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/faroFingerprintText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Device name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device name (shown in Faro)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/faroDeviceNameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_background"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:hint="Pixel 8"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

        <!-- Pairing -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pairing"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/faroPairButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Show pairing code"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/indigo"
            android:layout_marginTop="6dp"
            android:enabled="false" />

        <LinearLayout
            android:id="@+id/faroPairingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter this code in Faro on your computer"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/faroPairingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="000000"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.3"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/faroPairingCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/faroCancelPairingButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Close pairing"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/bg_card_elevated"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Paired controllers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paired computers"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/faroNoPeersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="None yet — open a pairing window and add this device from Faro."
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:id="@+id/faroPeersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <!-- Policy -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What paired computers may do"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow writing files"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off = read-only: uploads, deletes, and renames are refused"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/faroAllowWriteToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow running commands"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sandboxed shell (sh) as this app — no root"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/faroAllowExecToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
