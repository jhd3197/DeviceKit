<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: diagonal brand gradient (plan 27) matching the web master
     (DeviceKitLogo.svg) #6366f1 -> #4f46e5. <gradient> in a VectorDrawable fill is API 24+;
     adaptive icons are API 26+ (mipmap-anydpi-v26), so it is always supported here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#6366F1"
                android:endColor="#4F46E5" />
        </aapt:attr>
    </path>
</vector>
